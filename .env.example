# Flask. FLASK_DEBUG debe permanecer false para la demo PE2.
FLASK_SECRET_KEY=
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
FLASK_DEBUG=false

# Acceso local. Definir valores propios fuera del repositorio.
ACCESS_CODE=

# Integración Raspberry Pi / dron.
RPI_IP=172.20.10.3
RPI_PORT=5000
DRONE_TELEMETRY_STALE_SECONDS=5.0

# Persistencia. DB y campaigns deben respaldarse y restaurarse juntos.
DATABASE_URL=sqlite:///data/ground_control.db
CAMPAIGN_STORAGE_ROOT=data/campaigns

# Fotogrametría. Para demo usar PROCESSING_ENABLED=false.
PHOTOGRAMMETRY_BACKEND=MOCK
PROCESSING_ENABLED=false

# Navegación de exposición PE2.
PE2_DEMO_MODE=false

MOCK_PHOTOGRAMMETRY_DELAY_SECONDS=0

# Solo para procesamiento Metashape real.
METASHAPE_EXECUTABLE=

# Staging e importación RedEdge.
RED_EDGE_STAGING_ROOT=data/rededge_staging
RED_EDGE_UPLOAD_BATCH_MAX_FILES=25
RED_EDGE_STAGING_MAX_AGE_HOURS=24